From c342736a2d7c040db8337a906d8f06b3ac9f91f6 Mon Sep 17 00:00:00 2001
From: Hermes <hermes@localhost>
Date: Wed, 4 Nov 2026 04:31:40 +0200
Subject: [PATCH 01/13] Add i18n infrastructure (flutter_localizations,
 l10n.yaml, app_en.arb)

- flutter_localizations dependency, generate: true, l10n.yaml
- app_en.arb template with ~110 strings incl. settings labels,
  update dialog, rotate hint, location warning, snackbars,
  tooltips and all WMO weather descriptions, with @-metadata
  (flat placeholder types)
---
 analysis_options.yaml              |   7 +
 l10n.yaml                          |   3 +
 lib/l10n/app_en.arb                | 420 +++++++++++++
 lib/l10n/app_localizations.dart    | 919 +++++++++++++++++++++++++++++
 lib/l10n/app_localizations_en.dart | 418 +++++++++++++
 pubspec.lock                       |  25 +-
 pubspec.yaml                       |   5 +-
 7 files changed, 1786 insertions(+), 11 deletions(-)
 create mode 100644 l10n.yaml
 create mode 100644 lib/l10n/app_en.arb
 create mode 100644 lib/l10n/app_localizations.dart
 create mode 100644 lib/l10n/app_localizations_en.dart

